{
  "name": "@rolldate/events",
  "version": "0.1.0-beta.1",
  "private": false,
  "description": "RollDate Events — high-performance virtualized JavaScript event calendar (Free)",
  "type": "module",
  "main": "./dist/rolldate-events.cjs",
  "module": "./dist/rolldate-events.mjs",
  "types": "./dist/rolldate-events.d.ts",
  "style": "./dist/rolldate-events.css",
  "exports": {
    ".": {
      "types": "./dist/rolldate-events.d.ts",
      "import": "./dist/rolldate-events.mjs",
      "require": "./dist/rolldate-events.cjs",
      "default": "./dist/rolldate-events.mjs"
    },
    "./styles": "./dist/rolldate-events.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/rolldate-events.mjs",
    "dist/rolldate-events.cjs",
    "dist/rolldate-events.d.ts",
    "dist/rolldate-events.css",
    "dist/rolldate-events.mjs.map",
    "dist/rolldate-events.cjs.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run verify",
    "build": "npm run build:lite",
    "build:lite": "rimraf dist && rollup -c rollup.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:pack": "node scripts/smoke-pack.mjs"
  },
  "keywords": [
    "calendar",
    "events",
    "rolldate",
    "virtualized",
    "event-calendar"
  ],
  "author": "Abramov Yevhen <rolldate.support@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abramov-Front-end/rolldate-events.git"
  },
  "homepage": "https://rolldate.dev/",
  "bugs": {
    "url": "https://github.com/Abramov-Front-end/rolldate-events/issues",
    "email": "rolldate.support@gmail.com"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.15.21",
    "rimraf": "^6.0.1",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "jsdom": "^26.1.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
